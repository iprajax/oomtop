# TYPE oomtop_group_cpu_percent gauge
oomtop_group_cpu_percent{kind="agent_session",label="Claude Code"} 1.5
oomtop_group_cpu_percent{kind="app",label="we\"ird\\app\nx"} 1.5
oomtop_group_cpu_percent{kind="build_daemon",label="GradleDaemon"} 3
oomtop_group_cpu_percent{kind="model_server",label="sd-server"} 1.5
# HELP oomtop_group_reclaim_gain_bytes Estimated RAM freed if the group were stopped.
# TYPE oomtop_group_reclaim_gain_bytes gauge
oomtop_group_reclaim_gain_bytes{kind="agent_session",label="Claude Code"} 268435456
oomtop_group_reclaim_gain_bytes{kind="app",label="we\"ird\\app\nx"} 536870912
oomtop_group_reclaim_gain_bytes{kind="build_daemon",label="GradleDaemon"} 3221225472
oomtop_group_reclaim_gain_bytes{kind="model_server",label="sd-server"} 5368709120
# HELP oomtop_group_processes Processes in the group(s).
# TYPE oomtop_group_processes gauge
oomtop_group_processes{kind="agent_session",label="Claude Code"} 1
oomtop_group_processes{kind="app",label="we\"ird\\app\nx"} 1
oomtop_group_processes{kind="build_daemon",label="GradleDaemon"} 2
oomtop_group_processes{kind="model_server",label="sd-server"} 1
# HELP oomtop_group_count Groups sharing this kind and label.
# TYPE oomtop_group_count gauge
oomtop_group_count{kind="agent_session",label="Claude Code"} 1
oomtop_group_count{kind="app",label="we\"ird\\app\nx"} 1
oomtop_group_count{kind="build_daemon",label="GradleDaemon"} 2
oomtop_group_count{kind="model_server",label="sd-server"} 1
# HELP oomtop_group_idle_count Idle groups sharing this kind and label.
# TYPE oomtop_group_idle_count gauge
