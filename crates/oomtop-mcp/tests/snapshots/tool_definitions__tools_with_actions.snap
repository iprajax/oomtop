  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Can it fit?"
    },
    "description": "Call before loading a large model or starting heavy work. Give exactly one of `bytes`, `size` (e.g. \"13G\") or `model_path` (GGUF/safetensors; only headers are read). Answers `yes`, `yes_after_reclaim` (with the idle groups to stop and their estimated gain) or `no` (with the shortfall). Advisory only and valid for 10 s; never includes the calling agent's own session.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "description": "Memory needed, in bytes.",
          "minimum": 0,
          "type": "integer"
        },
        "gpu_resident": {
          "description": "The need lives in GPU memory (checked against the GPU/Metal budget too). Default false.",
          "type": "boolean"
        },
        "label": {
          "description": "What is being loaded, for the answer text.",
          "type": "string"
        },
        "model_path": {
          "description": "Local model file to estimate (headers only).",
          "type": "string"
        },
        "size": {
          "description": "Memory needed as a size, e.g. \"13G\", \"800MiB\".",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "can_fit",
    "outputSchema": {
      "properties": {
        "advisory": {
          "type": "boolean"
        },
        "as_of_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "expires_at_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "fit": {
          "properties": {
            "answer": {
              "enum": [
                "yes",
                "yes_after_reclaim",
                "no"
              ],
              "type": "string"
            },
            "gain": {
              "minimum": 0,
              "type": "integer"
            },
            "reclaim": {
              "items": {
                "properties": {
                  "gain": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "gpu_gain": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "group_id": {
                    "type": "string"
                  },
                  "idle_for_s": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "kind": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "orphan": {
                    "type": "boolean"
                  },
                  "swap_gain": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "group_id",
                  "label",
                  "kind",
                  "gain"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "shortfall": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "answer"
          ],
          "type": "object"
        },
        "gpu_checked": {
          "type": "boolean"
        },
        "gpu_free": {
          "type": [
            "integer",
            "null"
          ]
        },
        "headroom": {
          "type": [
            "integer",
            "null"
          ]
        },
        "host_need": {
          "minimum": 0,
          "type": "integer"
        },
        "need": {
          "properties": {
            "bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "gpu_bytes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
