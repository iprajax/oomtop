          "type": "array"
        },
        "reason": {
          "type": "string"
        },
        "schema_version": {
          "minimum": 0,
          "type": "integer"
        },
        "summary": {
          "type": "string"
        },
        "valid_for_s": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "as_of_ms",
        "summary",
        "fit",
        "need",
        "need_source",
        "headroom",
        "valid_for_s",
        "reason",
