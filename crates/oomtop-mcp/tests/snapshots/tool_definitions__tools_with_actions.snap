            ],
            "type": "object"
          },
          "type": "array"
        },
        "schema_version": {
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "done",
            "partial",
            "declined",
            "cancelled",
            "not_confirmed",
            "needs_user",
            "unavailable",
            "nothing_to_do",
            "failed"
          ],
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "targets": {
          "items": {
            "properties": {
              "expected_gain": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "group_id": {
                "type": "string"
              },
              "idle": {
                "type": "boolean"
              },
              "idle_for_s": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "kind": {
                "type": "string"
              },
              "label": {
